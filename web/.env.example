# Copy to .env.local. Every NEXT_PUBLIC_ value is inlined at build time, so set all of
# them for the network you build for — a build inherits anything left over.

# ── Mainnet, second version (deployed 2026-10-04) ────────────────────────────
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_RPC_URL=https://api.cartridge.gg/x/starknet/mainnet
NEXT_PUBLIC_EXPLORER=https://starkscan.co
# Live STRK20 privacy pool, class 0x6d163f2b27df0f53c5b0d019366261ba8034af1bef949dee920a60fe58bcf83.
NEXT_PUBLIC_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
NEXT_PUBLIC_AUCTION_ADDRESS=0x01b81e43fa60a6ef78ed86fdcd472a1f0072fc1556723f04b94d8ac8c62908c7
NEXT_PUBLIC_ANONYMIZER_ADDRESS=0x00cb8007daa66eb9eb92c3b3e5a4e2b27f848ccef08d6e7688a2a737ff94e050
NEXT_PUBLIC_AUCTION_DEPLOY_BLOCK=15866452
# The first-version auction, shown read-only.
NEXT_PUBLIC_AUCTION_ADDRESS_V1=0x02d893acf290c61be4afb6999d6fa39244fba514267c1ccea9e124af64bb6831

# The reveal relay posts encrypted reveals and disputes from its own account. Server only;
# the key is never committed. Leave NEXT_PUBLIC_RELAY unset to turn the relay off.
NEXT_PUBLIC_RELAY=on
RELAY_ADDRESS=
RELAY_PRIVATE_KEY=

