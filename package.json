{
  "name": "vickrey",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sealed-bid Vickrey auctions on STRK20 where the losing bids are never published",
  "workspaces": [
    "client",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace @vickrey/web",
    "dev": "npm run dev --workspace @vickrey/web",
    "test": "npm run test --workspace @vickrey/client && npm run test --workspace @vickrey/web",
    "typecheck": "npm run typecheck --workspace @vickrey/client && npm run typecheck --workspace @vickrey/web",
    "verify:pool": "npm run verify:pool --workspace @vickrey/client",
    "contracts:build": "scarb build",
    "contracts:test": "snforge test",
    "check:links": "node scripts/check-links.mjs",
    "check:reachability": "node scripts/check-reachability.mjs",
    "check:mobile": "node scripts/mobile-audit.mjs",
    "verify:private": "node scripts/verify-private-tx.mjs",
    "check:submission": "node scripts/check-submission.mjs",
    "shots": "node scripts/shots.mjs",
    "pixel-diff": "node scripts/pixel-diff.mjs",
    "check:motion": "node scripts/motion-check.mjs",
    "reconcile-probe": "node scripts/reconcile-probe.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.9.0"
  }
}
